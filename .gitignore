# Python virtual environments
venv/
.venv/

# Runtime data, caches and logs
# (replaces the old over-broad "*/" rule, which silently ignored every subfolder)
__pycache__/
*.pyc
*.pyo
logs/
users/
~/

# Data and document file types (credentials.json and token.json land here too)
*.json
*.pdf
*.txt

# System files
.DS_Store
Thumbs.db

# Logs and environment config
*.log
.env
.env.*
config.py

# Explicit private data files
wood.pdf
new_users.txt
registered_users.txt